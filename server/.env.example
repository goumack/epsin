# Copiez ce fichier en .env et renseignez vos valeurs.
# .env n'est jamais commité : il contient vos secrets.

# ---------- Base de données ----------
# En local (Docker) :
DATABASE_URL=postgresql://postgres:epsin@localhost:5440/epsin
DATABASE_SSL=false

# En production (Neon) — prenez la connexion « pooled » :
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true

# ---------- Authentification ----------
# En production, cette variable est OBLIGATOIRE : sans elle le serveur
# refuse de démarrer. Render la génère automatiquement.
JWT_SECRET=changez-cette-valeur-en-production
JWT_EXPIRES=12h

# ---------- Serveur ----------
PORT=4000

# Domaines autorisés à appeler l'API, séparés par des virgules.
# En production : l'URL exacte de l'interface.
CORS_ORIGIN=http://localhost:5173

# ---------- Protection contre le bourrage de mots de passe ----------
# Échecs tolérés par compte avant blocage temporaire.
LOGIN_MAX_ECHECS=20
LOGIN_WINDOW_MIN=15
