{
  "name": "epsin-server",
  "version": "1.0.0",
  "description": "EPSIN — API de gestion scolaire",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "historique": "node src/db/historique.js",
    "comptes-tuteurs": "node src/db/comptes-tuteurs.js",
    "installer": "npm run migrate && npm run seed && npm run historique && npm run comptes-tuteurs",
    "init-production": "node src/db/init-production.js",
    "reinitialiser-base": "node src/db/reinitialiser-base.js",
    "configurer-rentree": "node src/db/configurer-rentree.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
